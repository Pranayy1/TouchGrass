{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TouchGrass",
  "version": "1.1.1",
  "identifier": "com.Pranay.touchgrass",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "TouchGrass",
        "width": 1500,
        "height": 1000,
        "minWidth": 900,
"minHeight": 600,
        "decorations": true
      }
    ],
   "security": {
  "csp": "default-src 'self' tauri: asset:; script-src 'self'; style-src 'self'; img-src 'self' data: asset:; media-src 'self' data: asset: https://www.dropbox.com https://dl.dropboxusercontent.com;"
}
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {}
}
