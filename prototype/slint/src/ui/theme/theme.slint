// TouchGrass Design System – Theme Module
// This module defines the Theme enum and ThemeState global,
// and re-exports all the design tokens (colors, spacing, typography, radius, elevation)
// for convenience.

export enum Theme {
    Light,
    Dark,
}

export global ThemeState {
    in property <Theme> current-theme: Theme.Light;
}

// Re-export the token files
export { Spacing } from "./spacing.slint";
export { Typography, TextStyle } from "./typography.slint";
export { Radius } from "./radius.slint";
export { Elevation } from "./elevation.slint";
// Re-export Colors from colors.slint (unchanged)
export { Colors } from "./colors.slint";