// TouchGrass Design System – Theme Module
// This module re-exports the Theme enum and ThemeState from colors.slint,
// and also re-exports all the design tokens (colors, spacing, typography, radius, elevation)
// for convenience. The color tokens are already theme-aware (they depend on current_theme).

// Re-export the Theme enum and the ThemeState global from colors.slint.
// Slint does not support re-exporting a single property like `current_theme` as a standalone symbol.
export { Theme, ThemeState, Colors } from "./colors.slint";

// Re-export the other token files
export { Spacing } from "./spacing.slint";
export { Typography, TextStyle } from "./typography.slint";
export { Radius } from "./radius.slint";
export { Elevation } from "./elevation.slint";