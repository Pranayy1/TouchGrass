// TouchGrass Design System – Tokens Module
// Exported globals containing constant design tokens.
// No bindings, no conditionals, only literal values.

export global Sizes {
    out property <length> icon-small: 16px;
    out property <length> icon-medium: 24px;
    out property <length> icon-large: 32px;
    out property <length> window-min-width: 200px;
    out property <length> window-min-height: 100px;
    out property <length> button-width: 100px;
    out property <length> button-height: 36px;
    out property <length> dashboard-app-name-width: 100px;
    out property <length> dashboard-duration-width: 80px;
    out property <length> stat-tile-height: 60px;
    out property <length> nav-bar-width: 200px;
}