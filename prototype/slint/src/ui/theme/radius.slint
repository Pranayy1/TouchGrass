// TouchGrass Design System – Radius Tokens
export global Radius {
	out property <length> radius-none: 0px;
	out property <length> radius-sm: 4px;
	out property <length> radius-md: 8px;
	out property <length> radius-lg: 12px;
	out property <length> radius-pill: 9999px; // effectively a capsule (use height/2)
	out property <length> radius-button: 6px;
	out property <length> radius-card: 8px;
}