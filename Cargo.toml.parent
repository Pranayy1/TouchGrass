[package]
name = "touchgrass_prototype"
version = "0.1.0"
edition = "2021"

[dependencies]
slint = "1.17"
serde = { version = "1.0", features = ["derive"] }
chrono = "0.4"
serde_json = "1.0"
thiserror = "1.0"
windows-sys = { version = "0.52", features = ["Win32_Foundation", "Win32_System_Threading", "Win32_UI_WindowsAndMessaging"] }

[dev-dependencies]
tempfile = "3.0"

[build-dependencies]
slint-build = "1.17"